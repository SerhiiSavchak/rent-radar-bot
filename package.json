{
  "name": "rent-radar-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 1 source layer: monitor OLX, DIM.RIA, LUN and RIELTOR.UA rental listings for Lviv.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "live:olx": "tsx src/scripts/test-olx.ts",
    "live:olx:experiment": "tsx src/scripts/oracle-olx-experiment.ts",
    "live:olx:browser-experiment": "tsx src/scripts/oracle-olx-browser-experiment.ts",
    "live:olx:browser-extract": "tsx src/scripts/oracle-olx-browser-extract.ts",
    "live:olx:owner-detail": "tsx src/scripts/oracle-olx-owner-detail.ts",
    "live:oracle:soak": "tsx src/scripts/oracle-soak.ts",
    "test:lifecycle-smoke": "bash scripts/oracle-telegram-test/test-lifecycle-smoke.sh",
    "live:test-telegram": "tsx src/scripts/test-telegram.ts",
    "live:test-telegram:poll": "tsx src/scripts/test-telegram-poll.ts",
    "live:test-telegram:canary": "tsx src/scripts/test-telegram-canary.ts",
    "live:domria": "tsx src/scripts/test-domria.ts",
    "live:lun": "tsx src/scripts/test-lun.ts",
    "live:rieltor": "tsx src/scripts/test-rieltor.ts",
    "live:rieltor-cycles": "tsx src/scripts/test-rieltor-cycles.ts",
    "live:all": "tsx src/scripts/test-all-sources.ts",
    "research:lun-origins": "tsx src/scripts/research-lun-origins.ts",
    "test:olx": "tsx src/scripts/test-olx.ts",
    "test:domria": "tsx src/scripts/test-domria.ts",
    "test:lun": "tsx src/scripts/test-lun.ts",
    "test:rieltor": "tsx src/scripts/test-rieltor.ts",
    "test:sources": "tsx src/scripts/test-all-sources.ts",
    "probe:cf:fixtures": "tsx src/scripts/probe-cloudflare-local.ts fixtures",
    "probe:cf:olx": "tsx src/scripts/probe-cloudflare-local.ts live-olx",
    "probe:cf:bundle": "npx wrangler deploy --dry-run --outdir ../../dist-cf-probe --config probe/cloudflare-workers/wrangler.toml"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "playwright": "^1.63.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
