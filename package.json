{
  "name": "rent-radar-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 0 prototype: monitor OLX, DIM.RIA and LUN rental listings for Lviv.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "live:olx": "tsx src/scripts/test-olx.ts",
    "live:domria": "tsx src/scripts/test-domria.ts",
    "live:lun": "tsx src/scripts/test-lun.ts",
    "live:all": "tsx src/scripts/test-all-sources.ts",
    "test:olx": "tsx src/scripts/test-olx.ts",
    "test:domria": "tsx src/scripts/test-domria.ts",
    "test:lun": "tsx src/scripts/test-lun.ts",
    "test:sources": "tsx src/scripts/test-all-sources.ts",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
