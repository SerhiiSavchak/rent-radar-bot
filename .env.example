NODE_ENV=development
LOG_LEVEL=info

TARGET_CITY=Lviv
TARGET_LAT=49.8397
TARGET_LNG=24.0297
TARGET_RADIUS_KM=15
GEO_UNKNOWN_POLICY=exclude

POLL_INTERVAL_SECONDS=120
LUN_POLL_INTERVAL_SECONDS=120
DOMRIA_POLL_INTERVAL_SECONDS=10800
SOURCE_TIMEOUT_MS=15000
SOURCE_MAX_RETRIES=2
SOURCE_FAILURES_BEFORE_UNHEALTHY=3

ENABLE_DOMRIA=true
ENABLE_LUN=true
ENABLE_OLX=false
# Playwright catalog extract. Default false. When true, collection uses browser results
# and never falls back to the blocked OLX HTTP API. ENABLE_OLX stays the HTTP path.
ENABLE_OLX_BROWSER=false
ENABLE_RIELTOR=true

OWNER_ONLY=true
# Legacy. Ignored unless SELLER_POLICY=owner_only. Default approved policy keeps unknown sellers.
OWNER_ACCEPT_SELF_DECLARED=false
# Approved default: reject confirmed intermediaries; allow unknown and self-declared owners.
# Do not set owner_only in production — OWNER_ONLY=true will not restore it by itself.
SELLER_POLICY=reject_intermediaries
PROPERTY_TYPES=apartment,house
MAX_LISTING_AGE_MINUTES=

DOMRIA_API_KEY=
# html = production path, zero developers.ria.com calls.
# official = call the API only when the real poll tick fits 1000/month and 30/hour.
# DOMRIA_POLL_INTERVAL_SECONDS is not a separate scheduler.
DOMRIA_ACQUISITION=html
DOMRIA_USE_PUBLIC_HTML_FALLBACK=true
DOMRIA_MAX_INFO_PER_POLL=2

# TEST Telegram delivery (npm run live:test-telegram). Must be exactly "true" to send.
# Use only the developer-owned test bot/chat. Never point these at production/Igor destinations.
TELEGRAM_TEST_MODE=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DRY_RUN=true
# 0 = unbounded (systemd). Default 6 is a bounded manual poll.
TELEGRAM_POLL_CYCLES=6
TELEGRAM_POLL_INTERVAL_MS=600000
ADMIN_TELEGRAM_CHAT_ID=

# SQLite inventory. The default file is inside the checkout and may already be the
# live Oracle database. Do not delete it. Moving it is a later deployment task.
# Point tests and canaries at a different file.
DATABASE_PATH=./data/rent-radar.sqlite
# HEARTBEAT_PATH=./data/heartbeat.json
# Controlled canary (off by default). Never set TELEGRAM_CANARY=true in systemd.
# TELEGRAM_CANARY=false
# TELEGRAM_CANARY_DATABASE_PATH=./data/rent-radar-canary.sqlite

FIRST_RUN_MODE=seed
# seed = silent per-source baseline (default). preview = small «Початкова добірка».
# Legacy send is treated as preview (never unlabeled «нове» flood).
TELEGRAM_STRICT_NEW_PUBLICATIONS=true
TELEGRAM_INITIAL_PREVIEW_LIMIT=3
DRY_RUN=true
