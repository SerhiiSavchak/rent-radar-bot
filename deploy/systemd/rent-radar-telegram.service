[Unit]
Description=Rent Radar Telegram poller (local SQLite)
Documentation=file://__REPO_DIR__/docs/TELEGRAM_TEST_MODE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__REPO_DIR__
# Secrets only from the existing protected file. Missing file fails the unit.
EnvironmentFile=%h/.config/rent-radar/telegram-test.env
Environment=NODE_ENV=production
Environment=DATABASE_PATH=__DATABASE_PATH__
Environment=HEARTBEAT_PATH=__HEARTBEAT_PATH__
ExecStartPre=/bin/mkdir -p __RUNTIME_DIR__
ExecStartPre=/bin/chmod 700 __RUNTIME_DIR__
# Force unbounded poll and keep the blocked OLX HTTP adapter off even if the env file differs.
# ENABLE_OLX_BROWSER stays explicit in the env file only.
ExecStart=/usr/bin/env TELEGRAM_POLL_CYCLES=0 ENABLE_OLX=false __NPM_BIN__ run live:test-telegram:poll
Restart=on-failure
RestartSec=20
RestartPreventExitStatus=2
TimeoutStopSec=45
KillSignal=SIGTERM
KillMode=mixed
StandardOutput=append:__LOG_FILE__
StandardError=append:__LOG_FILE__
SyslogIdentifier=rent-radar-telegram
# systemd starts at most one instance of this unit name.

[Install]
WantedBy=default.target
