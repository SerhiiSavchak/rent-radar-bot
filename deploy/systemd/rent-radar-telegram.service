[Unit]
Description=Rent Radar Telegram poller (local SQLite)
Documentation=file://__REPO_DIR__/docs/TELEGRAM_TEST_MODE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__REPO_DIR__
# Secrets only from the existing protected file. Missing file fails the unit.
EnvironmentFile=%h/.config/rent-radar/telegram-test.env
Environment=NODE_ENV=production
Environment=DATABASE_PATH=__DATABASE_PATH__
Environment=HEARTBEAT_PATH=__HEARTBEAT_PATH__
# These override EnvironmentFile. HTTP OLX stays off. Browser OLX stays on. RIELTOR stays off.
Environment=ENABLE_DOMRIA=true
Environment=ENABLE_LUN=true
Environment=ENABLE_OLX=false
Environment=ENABLE_OLX_BROWSER=true
Environment=ENABLE_RIELTOR=false
Environment=GEO_UNKNOWN_POLICY=exclude
Environment=TARGET_RADIUS_KM=15
Environment=FIRST_RUN_MODE=seed
ExecStartPre=/bin/mkdir -p __RUNTIME_DIR__
ExecStartPre=/bin/chmod 700 __RUNTIME_DIR__
# Canonical production entry. src/index.ts exits 2 and does not persist or send.
# Node is the main process. KillMode=control-group delivers SIGTERM to it and to Chromium.
ExecStart=/usr/bin/env TELEGRAM_POLL_CYCLES=0 ENABLE_OLX=false ENABLE_OLX_BROWSER=true ENABLE_RIELTOR=false __NODE_BIN__ --import tsx ./src/scripts/test-telegram-poll.ts
Restart=on-failure
RestartSec=20
RestartPreventExitStatus=2 3
TimeoutStopSec=45
KillSignal=SIGTERM
KillMode=control-group
StandardOutput=append:__LOG_FILE__
StandardError=append:__LOG_FILE__
SyslogIdentifier=rent-radar-telegram
# systemd starts at most one instance of this unit name.

[Install]
WantedBy=default.target
